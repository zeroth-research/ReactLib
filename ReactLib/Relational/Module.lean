import Relational.Basic

/-!
  Reactive modules and their semantics as transition systems (`toTS`).
-/

universe u v

structure ReactiveModule (Extl: Type u) (State: Type u) where
  init   : Extl → State
  update : State → Extl → State
  init_pre: Extl → Prop
  update_pre: Extl → Prop

namespace ReactiveModule

/-- describe traces of RM (this basically defines the semantics) -/
def traces (module: ReactiveModule Extl State)
  (ss: Cslib.ωSequence State): Prop :=
  (∃l, module.init_pre l ∧         -- initial inputs satisfy precondition
   ss 0 = module.init l) ∧      -- initial state is defined by `init`
  ∀ i: Nat, ∃ l: Extl,
    module.update_pre l ∧
    -- don't forget that inputs are shifted by 1, because the first inputs
    -- are used for initial states
    (ss (i + 1)) = module.update (ss i) l

/-- describe a trace of a RM generated by a sequence of inputs  -/
def traces'
  (module: ReactiveModule Extl State)
  (ss: Cslib.ωSequence State)
  (inps: Cslib.ωSequence Extl): Prop :=
  (module.init_pre inps.head ∧          -- initial inputs satisfy precondition
   ss 0 = module.init (inps 0)) ∧       -- initial state is defined by `init`
  ∀ i: Nat,
    module.update_pre (inps i) ∧
    -- don't forget that inputs are shifted by 1, because the first inputs
    -- are used for initial states
    (ss (i + 1)) = module.update (ss i) (inps (i + 1))

theorem traces'_impl_traces (module: ReactiveModule Extl State):
  module.traces' ss inps → module.traces ss := by
  unfold traces traces'
  simp_all
  intro h hs hi
  constructor
  . refine ⟨ inps.head, ?_⟩
    constructor
    . exact h
    . have : inps 0 = inps.head := by
        unfold Cslib.ωSequence.head
        rfl
      rw [this]
  . intro i
    exact ⟨inps (i + 1), (hi (i + 1)).1, rfl⟩


def TS_init (M: ReactiveModule Extl State)
  := fun x => ∃ l, M.init_pre l ∧ M.init l = x

def TS_update (M: ReactiveModule Extl State)
  := fun x l x' => M.update_pre l ∧ M.update x l = x'

def toTS (module: ReactiveModule Extl State): TS State Extl :=
  {
    Tr   := module.TS_update
    start := module.TS_init
  }

/-- The TS for a reactive module defines exactly the traces of the
    reactive module -/
theorem TS_traces (M: ReactiveModule Extl State):
  ∀ ss μs, M.toTS.ωTrace ss μs → M.traces ss := by
  intro ss μs h
  unfold traces
  simp_all [toTS, TS.ωTrace, Cslib.LTS.OmegaExecution]
  constructor
  case left =>
    have hi := h.left
    simp [TS_init] at hi
    have : ss 0 = ss.get 0 := by rfl
    simp [this, Eq.comm]
    exact hi
  case right =>
    intro i
    have hi := h.right i
    simp [TS_update] at hi
    refine ⟨ (μs i), ?_⟩
    rw [Eq.comm]
    exact hi

theorem traces_to_TS (M: ReactiveModule Extl State):
  ∀ ss, M.traces ss → (∃ μs, M.toTS.ωTrace ss μs) := by
  intro ss
  simp [traces]
  have : ss 0 = ss.get 0 := rfl
  simp_all [toTS, Cslib.LTS.OmegaExecution, TS_init, TS_update, TS.ωTrace]
  intro x hx hs hi
  constructor
  . refine ⟨ x, ?_⟩
    exact ⟨ hx, rfl ⟩
  . exact ⟨fun i => (hi i).choose, fun i =>
    let ⟨hpre, hupd⟩ := (hi i).choose_spec
    ⟨hpre, hupd.symm⟩⟩


/- composition of two reactive modules over the same inputs and states:
   the composition of their TSs. It is a TS and not a `ReactiveModule`,
   since two update functions cannot be merged into one. -/
def compose (A B : ReactiveModule Extl State) : TS State Extl :=
  A.toTS.compose B.toTS

/- the traces of a composition are exactly the traces common to both
   modules -/
theorem compose_ωTrace (A B : ReactiveModule Extl State) :
    (A.compose B).ωTrace ss μs ↔ A.toTS.ωTrace ss μs ∧ B.toTS.ωTrace ss μs :=
  TS.ωTrace_compose _ _

/- a trace of the composition is a trace of both modules -/
theorem compose_traces (A B : ReactiveModule Extl State) :
    (∃ μs, (A.compose B).ωTrace ss μs) → A.traces ss ∧ B.traces ss := by
  intro ⟨μs, h⟩
  have ⟨hA, hB⟩ := (compose_ωTrace A B).mp h
  exact ⟨A.TS_traces ss μs hA, B.TS_traces ss μs hB⟩

/- a trace of both modules for the same inputs is a trace of the
   composition -/
theorem traces'_compose (A B : ReactiveModule Extl State)
    (hA : A.traces' ss inps) (hB : B.traces' ss inps) :
    (A.compose B).ωTrace ss (fun i => inps (i + 1)) := by
  rw [compose_ωTrace]
  have tr : ∀ M : ReactiveModule Extl State, M.traces' ss inps →
      M.toTS.ωTrace ss (fun i => inps (i + 1)) := by
    intro M ⟨⟨hpre, h0⟩, hi⟩
    refine ⟨⟨inps 0, hpre, h0.symm⟩, fun i => ⟨(hi (i + 1)).1, (hi i).2.symm⟩⟩
  exact ⟨tr A hA, tr B hB⟩

end ReactiveModule
